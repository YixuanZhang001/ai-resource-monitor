# API Key 安全：本地配置绝不入库
data/config.yaml
data/config.yml
# 本地 manual 凭据存储（P1）：仅本机、0600、绝不入库
data/credentials.json
data/credentials.json-*

# 数据库永不入库（含备份与 WAL）
data/*.db
data/*.db-*
data/backups/

__pycache__/
*.pyc
.pytest_cache/
.venv/

# 临时诊断/运行日志（含后台服务日志），不入库
.tmp_*
arm_pytest_tmp/

# 构建 / 打包产物
build/
dist/
*.egg-info/
src/

# 测试 / lint 缓存
.ruff_cache/
.coverage
htmlcov/
.pytest-tmp/

